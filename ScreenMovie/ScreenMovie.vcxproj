  <!-- DUI 公共编译基线：C++20 / /MT / /EHs-c- / /GR- / /utf-8 / W4 + PerMonitorV2 manifest -->
  <Import Project="..\..\DUI\DUI.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- 与 DUI.lib 的 /EHs-c- 保持一致：不生成异常展开表，减小体积（C4530 已在 pch.h 抑制） -->
      <ExceptionHandling>false</ExceptionHandling>
      <!-- Release 以体积优先：/O1 比 /O2 小 5~15%，录制场景瓶颈在 D3D/GDI 而非 CPU -->
      <Optimization Condition="'$(Configuration)'=='Release'">MinSpace</Optimization>
      <FunctionLevelLinking Condition="'$(Configuration)'=='Release'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)'=='Release'">false</IntrinsicFunctions>
      <AdditionalIncludeDirectories>$(SolutionDir)..\DUI;$(ProjectDir)..\Src;D:\sdk\gifski;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Debug'">true</GenerateDebugInformation>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Release'">false</GenerateDebugInformation>
      <!-- 链接期剔除未引用代码/折叠相同 COMDAT -->
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
      <AdditionalDependencies>$(SolutionDir)..\DUI\Build\DUI\$(Configuration)\DUI.lib;mf.lib;mfreadwrite.lib;mfplat.lib;mfuuid.lib;propsys.lib;D:\sdk\gifski\target\release\gifski.lib;ws2_32.lib;ntdll.lib;Userenv.lib;dwmapi.lib;shlwapi.lib;windowscodecs.lib;comctl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if not exist "$(TargetDir)iconfont.ttf" copy "$(ProjectDir)..\Src\Res\iconfont.ttf" "$(TargetDir)iconfont.ttf" &gt;nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
